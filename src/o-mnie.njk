---
layout: base.njk
title: O mnie
permalink: /o-mnie/
---
{% set a = about %}
<section class="about container">
  <div class="about-text">
    <h1 class="big">{{ a.heading }}</h1>
    <p class="serif sub">{{ a.subheading }}</p>
    <p class="about-title">{{ a.title }}</p>
    {% for p in a.text | paras %}<p>{{ p }}</p>{% endfor %}
  </div>
  {% if a.image %}<img class="about-img" src="{{ a.image }}" alt="{{ site.name }}" loading="lazy">{% endif %}
</section>

<section class="education container">
  <h2 class="mid">Edukacja</h2>
  <div class="edu-list">
    {% for e in a.education %}
    <div class="edu-row">
      <div class="edu-left"><p class="years">{{ e.years }}</p><p>{{ e.title }}</p></div>
      <ul>{% for line in e.details | lines %}{% if line | trim %}<li>{{ line }}</li>{% endif %}{% endfor %}</ul>
    </div>
    {% endfor %}
  </div>
</section>

<section class="touch container">
  <h2 class="mid">Get in Touch</h2>
  <a href="tel:{{ site.phone | replace(' ', '') | replace('-', '') }}">{{ site.phone }}</a>
  <a href="mailto:{{ site.email }}">{{ site.email }}</a>
  <a class="btn" href="{{ site.booking_url }}" target="_blank" rel="noopener">{{ site.booking_label }}</a>
</section>
